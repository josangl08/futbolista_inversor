# CONFIGURACIÓN DE EMAIL - PLANTILLA
# Copia este archivo como .env y completa con tus credenciales reales

# Servidor SMTP de Hostinger
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_ENCRYPTION=ssl

# Credenciales del email empresarial
SMTP_USERNAME=tu_email@tudominio.com
SMTP_PASSWORD=tu_contraseña_aqui
SMTP_FROM_EMAIL=tu_email@tudominio.com
SMTP_FROM_NAME=Formulario Web

# Email de destino para los mensajes del formulario
CONTACT_EMAIL=tu_email@tudominio.com
CONTACT_NAME=Tu Nombre o Empresa
