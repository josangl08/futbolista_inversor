# ============================================
# CONFIGURACIÓN DE SEGURIDAD - FUTBOLISTA INVERSOR
# Archivo .htaccess para Hostinger
# ============================================

# ---------------------------
# 1. FORZAR HTTPS
# ---------------------------
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ---------------------------
# 2. HEADERS DE SEGURIDAD HTTP
# ---------------------------
<IfModule mod_headers.c>

# Content Security Policy (CSP)
# Controla qué recursos pueden cargarse y desde dónde
Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://player.vimeo.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; frame-src https://player.vimeo.com; connect-src 'self';"

# HTTP Strict Transport Security (HSTS)
# Fuerza HTTPS por 6 meses en todos los subdominios
Header always set Strict-Transport-Security "max-age=15768000; includeSubDomains"

# X-Frame-Options
# Previene clickjacking - solo permite iframes del mismo origen
Header set X-Frame-Options "SAMEORIGIN"

# X-Content-Type-Options
# Previene MIME sniffing
Header set X-Content-Type-Options "nosniff"

# X-XSS-Protection
# Activa protección XSS del navegador
Header set X-XSS-Protection "1; mode=block"

# Referrer Policy
# Controla información del referrer enviada
Header set Referrer-Policy "strict-origin-when-cross-origin"

# Permissions Policy
# Deshabilita APIs del navegador innecesarias
Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"

</IfModule>

# ---------------------------
# 3. DESHABILITAR LISTADO DE DIRECTORIOS
# ---------------------------
Options -Indexes

# ---------------------------
# 4. PROTEGER ARCHIVOS SENSIBLES
# ---------------------------
<FilesMatch "\.(htaccess|htpasswd|ini|log|sh|sql)$">
Order Allow,Deny
Deny from all
</FilesMatch>

# Proteger específicamente el archivo .env
<Files ".env">
Order Allow,Deny
Deny from all
</Files>

# Proteger también archivos de ejemplo y otros relacionados
<FilesMatch "\.env.*">
Order Allow,Deny
Deny from all
</FilesMatch>

# ---------------------------
# 5. PROTEGER .GIT Y .VENV
# ---------------------------
RedirectMatch 404 /\.git
RedirectMatch 404 /\.venv_FI

# ---------------------------
# 6. COMPRESIÓN GZIP (Opcional - mejora rendimiento)
# ---------------------------
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# ---------------------------
# 7. CACHÉ DEL NAVEGADOR (Opcional - mejora rendimiento)
# ---------------------------
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/jpg "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/gif "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
ExpiresByType application/pdf "access plus 1 month"
</IfModule>

# ---------------------------
# FIN DE CONFIGURACIÓN
# ---------------------------
